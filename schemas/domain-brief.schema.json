{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab-gen-sim.local/schemas/domain-brief.schema.json",
  "title": "DomainBrief",
  "description": "Input for LLM-guided domain extension of general-simulation (demo fork only).",
  "type": "object",
  "required": [
    "domain_id",
    "display_name",
    "adapter_id",
    "entity_model",
    "data_source",
    "scenarios",
    "demo_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,48}$",
      "description": "Python package name under domain/"
    },
    "display_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "base_domain": {
      "type": "string",
      "enum": ["aviation", "shipping", "none"],
      "default": "none",
      "description": "Reference domain for few-shot examples only"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,48}$"
    },
    "entity_model": {
      "type": "object",
      "required": ["entities", "relationships"],
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "type"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "DEPENDS_ON",
                  "FEEDS",
                  "CARRIES",
                  "CONTAINS",
                  "LOCATED_AT",
                  "AFFECTED_BY"
                ]
              }
            }
          }
        },
        "entity_type_default": {
          "type": "string",
          "default": "fixed_node"
        },
        "id_prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,32}$",
          "description": "Prefix for CanonicalEntity.id values"
        }
      }
    },
    "data_source": {
      "type": "object",
      "required": ["mode", "description"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["synthetic", "live_api"]
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "auth_env_var": {
          "type": "string"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narrative", "affected_entity_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,64}$"
          },
          "narrative": {
            "type": "string",
            "minLength": 20
          },
          "affected_entity_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "event_type": {
            "type": "string",
            "default": "disruption"
          }
        }
      }
    },
    "demo_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "status_values": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["active", "inactive"]
    },
    "attribute_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Domain-specific keys stored in CanonicalEntity.attributes"
    },
    "geometry": {
      "type": "string",
      "enum": ["Point", "Polygon", "none"],
      "default": "Point"
    }
  }
}
